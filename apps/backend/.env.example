# ====== PostgreSQL 数据库连接 ======
# 本地 PostgreSQL 安装方式：
#   A. Docker（推荐）：
#      docker run -d --name led-postgres -e POSTGRES_USER=led -e POSTGRES_PASSWORD=led123 -e POSTGRES_DB=led -p 5432:5432 -v led-pgdata:/var/lib/postgresql/data postgres:16-alpine
#   B. Windows 安装包：https://www.postgresql.org/download/windows/  安装后创建 led 数据库
DATABASE_URL="postgresql://led:led123@localhost:5432/led?schema=public"

# ====== JWT ======
# 生产环境必须改为强随机字符串（例如 openssl rand -hex 32）
JWT_SECRET="led-dev-secret-change-me-in-production-please-2026"
JWT_EXPIRES_IN="7d"

# ====== Server ======
PORT=4000
# 前端地址（CORS 白名单）
CLIENT_ORIGIN="http://localhost:5173"
